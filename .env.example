# 이 파일은 커밋됩니다. 실제 시크릿 값은 절대 넣지 마세요.
# 실제 값은 .env 또는 .env.local에 작성합니다. (Git에 커밋되지 않음)

# PostgreSQL 연결 문자열 (Prisma 및 앱에서 사용)
DATABASE_URL="postgresql://user:password@localhost:5432/gto_site?schema=public"

# Docker Compose (postgres 서비스)용 변수.
# 실제 값은 .env에만 작성하고, 이 파일에는 placeholder만 넣으세요.
# docker-compose.yml은 프로젝트 루트 .env를 자동으로 읽어 사용합니다.
POSTGRES_USER="user"
POSTGRES_PASSWORD=""
POSTGRES_DB="gto_site"

# 인증 세션 서명용 시크릿 (32자 이상의 충분한 엔트로피를 가진 랜덤 문자열)
# 생성 예시: openssl rand -base64 32
# 실제 값은 .env에만 작성하고, 이 파일에는 절대 넣지 마세요.
AUTH_SECRET=""

# Production canonical origin (브라우저에 공개됨, secret 금지)
# 운영에서는 경로/쿼리 없는 HTTPS origin을 사용합니다. 예: https://example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# S23 공개 상태. Production에서 미설정/오류이면 앱 Proxy는 MAINTENANCE로 fail-closed 합니다.
SITE_AVAILABILITY="PUBLIC"

# S23 출시 단계 경계. Production에서는 모두 명시해야 하며 대한민국 표준시(+09:00)만 허용합니다.
LAUNCH_FREE_AT="2026-10-01T00:00:00+09:00"
LAUNCH_PAID_PRENOTICE_AT="2026-11-01T00:00:00+09:00"
LAUNCH_DISCOUNTED_PAID_AT="2026-12-01T00:00:00+09:00"
LAUNCH_STANDARD_PAID_AT="2027-01-01T00:00:00+09:00"
# 실제 PG가 없는 현재 허용값은 FREE_ONLY뿐입니다. 이 값은 live charge를 활성화하지 않습니다.
MONETIZATION_ACTIVATION_MODE="FREE_ONLY"

# 첨부파일 스토리지 (게시글 첨부 업로드)
# provider: local (기본값, 로컬 디스크)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"

# CBT 파이프라인 (tools/cbt) LLM 설정
# provider: deepseek (기본) | kimi | openai — 모두 OpenAI-compatible API로 동작
CBT_LLM_PROVIDER="deepseek"
CBT_LLM_BASE_URL="https://api.deepseek.com/v1"
# 실제 키는 .env에만 작성 (커밋 금지)
CBT_LLM_API_KEY=""
CBT_LLM_MODEL="deepseek-chat"
# 문제당 LLM 동시 호출 수 (rate limit/비용 고려)
CBT_LLM_CONCURRENCY="3"
CBT_LLM_MAX_RETRIES="3"
CBT_LLM_TIMEOUT_MS="60000"

# 관리자 Blog AI 초안 생성
# OpenCode Zen: Muse Responses API를 우선 호출하고 provider 실패 시 Ox Chat Completions를 1회 호출합니다.
# 기존 OpenAI-compatible 설정은 BLOG_AI_PROVIDER="openai-compatible"과 BLOG_AI_MODEL로 계속 사용할 수 있습니다.
# 실제 키는 .env/.env.local에만 작성하고, 운영에서는 HTTPS endpoint를 사용하세요.
BLOG_AI_PROVIDER="opencode-zen"
BLOG_AI_BASE_URL="https://opencode.ai/zen/v1"
BLOG_AI_API_KEY=""
BLOG_AI_PRIMARY_MODEL="muse-spark-1.2-contributor-free"
BLOG_AI_FALLBACK_MODEL="x-preview-f-free"
# BLOG_AI_MODEL="deepseek-chat"

# Blog 콘텐츠 생성 scheduler/cron 인증 시크릿 (최소 32자, Authorization: Bearer)
# scheduler가 GET 또는 POST /api/cron/blog-content 를 호출할 때 사용합니다.
BLOG_AUTOMATION_CRON_SECRET=""

# Lead Contact Unlock 정책. 실제 운영값을 명시해야 unlock API/action이 동작합니다.
# 숫자만 허용하며, 미설정 시 개인정보 unlock을 fail-closed 처리합니다.
LEAD_MAX_CONTACT_UNLOCKS_PER_LEAD=""

# S22 고객 문의 abuse guard. IP/연락처는 이 키로 HMAC 후 시간 버킷만 저장합니다.
# 32자 이상의 별도 랜덤 문자열을 권장하며, 미설정 시 AUTH_SECRET을 fallback으로 사용합니다.
SUPPORT_ABUSE_HASH_SECRET=""

# S22 Telegram Admin Ops (모두 서버 전용, NEXT_PUBLIC_ 접두사 금지)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# 허용할 Telegram numeric user ID를 쉼표로 구분합니다. chat ID만으로 권한을 부여하지 않습니다.
TELEGRAM_ADMIN_USER_IDS=""
# Telegram setWebhook secret_token과 동일한 32자 이상의 랜덤 문자열
TELEGRAM_WEBHOOK_SECRET=""

# GET/POST /api/cron/ops Bearer 인증용 32자 이상의 랜덤 문자열
OPS_AUTOMATION_CRON_SECRET=""
# Homepage synthetic showcase: development defaults ON; false/0 disables it.
# Ignored in production. No sample campaigns are stored or tracked.
ENABLE_HOMEPAGE_SAMPLE_INVENTORY=
