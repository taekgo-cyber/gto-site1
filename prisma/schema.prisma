// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum UserRole {
  USER // 일반 회원
  COMPANY // 업체 회원
  ADMIN // 관리자
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum CompanyStatus {
  PENDING // 승인 대기
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CompanyMemberRole {
  OWNER // 대표
  MANAGER // 관리자
  STAFF // 직원
}

enum CompanyMemberStatus {
  ACTIVE
  REMOVED
}

enum JobPostType {
  JOB // 구인공고
  TRANSPORT // 운송/배차 정보
}

enum JobPostStatus {
  DRAFT
  OPEN
  CLOSED
  HIDDEN
}

enum LeasePostType {
  HIRE // 지입 구인
  SEEK // 지입 구직
}

enum LeasePostStatus {
  DRAFT
  PUBLISHED
  CLOSED
  HIDDEN
}

enum AttachmentMediaType {
  IMAGE
  DOCUMENT
}

enum PayType {
  MONTHLY // 월급
  DAILY // 일급
  FREIGHT // 운임
  NEGOTIABLE // 협의
}

enum WorkType {
  FULL_TIME
  PART_TIME
  CONTRACT
  DAILY
  FREELANCE
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  BLOCKED
}

enum BlogArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogContentOrigin {
  MANUAL
  AI
}

enum BlogContentJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BlogContentAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  BLOCKED
}

enum ReportTargetType {
  POST
  COMMENT
  JOB_POST
  COMPANY
  USER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AdCampaignStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum AdAnalyticsEventType {
  IMPRESSION
  CLICK
  CONVERSION
}

enum ProductType {
  ADVERTISEMENT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CreditPackageStatus {
  ACTIVE
  INACTIVE
}

enum RecruitmentTier {
  GENERAL
  PREMIUM
  MAIN
}

enum QuotaAllowanceType {
  MATCH
  CONTACT_UNLOCK
}

enum CandidateLeadStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

enum LeadCloseReason {
  HIRED
  USER_CLOSED
  ADMIN_CLOSED
}

enum LeadMatchStatus {
  ACTIVE
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

// ---------------------------------------------------------------------------
// 회원 / 업체
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  nickname     String?    @unique
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companyMemberships    CompanyMember[]
  jobPosts              JobPost[]       @relation("JobPostAuthor")
  leasePosts            LeasePost[]     @relation("LeasePostAuthor")
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
  blogArticles          BlogArticle[]
  blogContentJobs       BlogContentJob[]       @relation("BlogContentJobRequester")
  blogAutomationControls BlogAutomationControl[] @relation("BlogAutomationControlUpdater")
  reports               Report[]        @relation("ReportReporter")
  handledReports        Report[]        @relation("ReportHandler")
  orders                Order[]
  adminLogs             AdminLog[]      @relation("AdminLogAdmin")
  cbtQuestionActivities CbtQuestionActivity[]
  cbtExamRecords        CbtExamRecord[]
  candidateLeads        CandidateLead[]
  leadMatchesActed      LeadMatch[]         @relation("LeadMatchActor")
  leadUnlocksActed      LeadContactUnlock[] @relation("LeadUnlockActor")

  // Credit foundation (Session 13) - Company-owned ledger, actor provenance distinct
  creditTransactionsActed CreditTransaction[] @relation("CreditTransactionActor")

  @@map("users")
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  businessNumber     String        @unique
  representativeName String
  phone              String?
  email              String?
  address            String?
  addressDetail      String?
  regionId           String?
  introduction       String?
  status             CompanyStatus @default(PENDING)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  region             Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  members            CompanyMember[]
  jobPosts           JobPost[]
  leasePosts         LeasePost[]
  adCampaigns        AdCampaign[]
  leadMatches        LeadMatch[]
  leadContactUnlocks LeadContactUnlock[]

  // Credit foundation (Session 13)
  creditAccount      CreditAccount?
  creditGrants       CreditGrant[]
  creditTransactions CreditTransaction[]
  recruitmentEntitlements CompanyRecruitmentEntitlement[]
  quotaUsages           CompanyQuotaUsage[]
  quotaConsumptions     CompanyQuotaConsumption[]

  @@index([name])
  @@map("companies")
}

model CompanyMember {
  id        String              @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMemberRole   @default(STAFF)
  status    CompanyMemberStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_members")
}

// ---------------------------------------------------------------------------
// 구인 / 운송 공고
// ---------------------------------------------------------------------------

model JobPost {
  id              String        @id @default(cuid())
  type            JobPostType   @default(JOB)
  title           String
  description     String?
  companyId       String?
  authorId        String?
  originRegionId  String?
  destRegionId    String?
  originAddress   String?
  destAddress     String?
  vehicleTypeId   String?
  tonnageId       String?
  payType         PayType?
  payAmount       Int?
  workType        WorkType?
  workDescription String?
  deadline        DateTime?
  publishedAt     DateTime?
  viewCount       Int           @default(0)
  status          JobPostStatus @default(OPEN)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  author       User?        @relation("JobPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  originRegion Region?      @relation("JobPostOrigin", fields: [originRegionId], references: [id], onDelete: SetNull)
  destRegion   Region?      @relation("JobPostDest", fields: [destRegionId], references: [id], onDelete: SetNull)
  vehicleType  VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  tonnage      Tonnage?     @relation(fields: [tonnageId], references: [id], onDelete: SetNull)

  @@index([status, type, publishedAt(sort: Desc)])
  @@index([companyId])
  @@index([authorId])
  @@index([originRegionId])
  @@index([destRegionId])
  @@index([deadline])
  @@map("job_posts")
}

// ---------------------------------------------------------------------------
// 지입 게시글
// ---------------------------------------------------------------------------

model LeasePost {
  id            String          @id @default(cuid())
  type          LeasePostType
  title         String
  content       String
  status        LeasePostStatus @default(DRAFT)
  viewCount     Int             @default(0)
  authorId      String
  companyId     String?
  regionId      String?
  vehicleTypeId String?
  tonnageId     String?
  payType       PayType?
  payAmount     Int?
  workType      WorkType?
  conditions    Json?
  publishedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  author      User                 @relation("LeasePostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  company     Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  region      Region?              @relation(fields: [regionId], references: [id], onDelete: SetNull)
  vehicleType VehicleType?         @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  tonnage     Tonnage?             @relation(fields: [tonnageId], references: [id], onDelete: SetNull)
  attachments LeasePostAttachment[]

  @@index([status, type, publishedAt(sort: Desc)])
  @@index([authorId])
  @@index([regionId])
  @@index([vehicleTypeId])
  @@index([tonnageId])
  @@map("lease_posts")
}

model LeasePostAttachment {
  id               String               @id @default(cuid())
  postId           String
  storageKey       String
  originalName     String
  mimeType         String
  fileSize         Int
  mediaType        AttachmentMediaType
  sortOrder        Int                  @default(0)
  isRepresentative Boolean              @default(false)
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())

  post LeasePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, deletedAt, sortOrder])
  @@map("lease_post_attachments")
}

// ---------------------------------------------------------------------------
// 마스터 데이터
// ---------------------------------------------------------------------------

model Region {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  depth     Int // 1: 시/도, 2: 시/군/구
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         Region?         @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Region[]        @relation("RegionTree")
  companies      Company[]
  jobPostsFrom   JobPost[]       @relation("JobPostOrigin")
  jobPostsTo     JobPost[]       @relation("JobPostDest")
  leasePosts     LeasePost[]
  adCampaigns    AdCampaign[]
  candidateLeads CandidateLead[]

  @@index([parentId])
  @@index([depth])
  @@map("regions")
}

model VehicleType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPosts       JobPost[]
  leasePosts     LeasePost[]
  candidateLeads CandidateLead[]

  @@map("vehicle_types")
}

model Tonnage {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  weightKg  Int?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPosts       JobPost[]
  leasePosts     LeasePost[]
  candidateLeads CandidateLead[]

  @@map("tonnages")
}

// ---------------------------------------------------------------------------
// 커뮤니티
// ---------------------------------------------------------------------------

model Board {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@map("boards")
}

model Post {
  id        String     @id @default(cuid())
  boardId   String
  authorId  String
  title     String
  content   String
  viewCount Int        @default(0)
  status    PostStatus @default(PUBLISHED)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  board    Board     @relation(fields: [boardId], references: [id])
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([boardId, status, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String
  status    CommentStatus @default(PUBLISHED)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReply")
  likes   Like[]

  @@index([postId, status, createdAt(sort: Desc)])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String?
  targetType  ReportTargetType
  targetId    String
  reason      String?
  status      ReportStatus     @default(PENDING)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter  User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

model BlogCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles BlogArticle[]

  @@index([isActive, sortOrder])
  @@map("blog_categories")
}

model BlogArticle {
  id              String            @id @default(cuid())
  categoryId      String?
  authorId        String?
  slug            String            @unique
  title           String
  excerpt         String?
  contentMarkdown   String
  tags              Json              @default("[]")
  featuredImageUrl  String?
  featuredImageAlt  String?
  contentOrigin     BlogContentOrigin  @default(MANUAL)
  aiGenerationMeta  Json?
  automationJobId   String?           @unique
  status            BlogArticleStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  automationJob BlogContentJob? @relation(fields: [automationJobId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId])
  @@map("blog_articles")
}

model BlogContentJob {
  id               String               @id @default(cuid())
  requestedById    String?
  topic            String
  targetKeyword    String
  sourceType       String
  sourceIds        Json                 @default("[]")
  instruction      String?
  topicKey         String               @unique
  idempotencyKey   String               @unique
  status           BlogContentJobStatus @default(QUEUED)
  scheduledFor     DateTime
  attemptCount     Int                  @default(0)
  maxAttempts      Int                  @default(3)
  lockedAt         DateTime?
  lockedBy         String?
  cancelRequestedAt DateTime?
  lastErrorCode    String?
  lastErrorAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  requestedBy User?                   @relation("BlogContentJobRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  article     BlogArticle?
  attempts    BlogContentJobAttempt[]

  @@index([status, scheduledFor])
  @@index([requestedById, createdAt(sort: Desc)])
  @@map("blog_content_jobs")
}

model BlogContentJobAttempt {
  id            String                   @id @default(cuid())
  jobId         String
  attemptNumber Int
  status        BlogContentAttemptStatus @default(RUNNING)
  runnerId      String
  errorCode     String?
  startedAt     DateTime                 @default(now())
  finishedAt    DateTime?

  job BlogContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([status, startedAt])
  @@map("blog_content_job_attempts")
}

model BlogAutomationControl {
  id          String   @id @default("default")
  isPaused    Boolean  @default(false)
  dailyLimit  Int      @default(10)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("BlogAutomationControlUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("blog_automation_controls")
}

// ---------------------------------------------------------------------------
// CBT (화물운송종사자격시험 문제은행)
// ---------------------------------------------------------------------------

model CbtCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   CbtQuestion[]
  examRecords CbtExamRecord[]

  @@index([sortOrder])
  @@map("cbt_categories")
}

model CbtQuestion {
  id            String         @id @default(cuid())
  categoryId    String
  subject       String
  questionText  String
  options       Json
  correctOption Int
  explanation   String?
  imageUrl      String?
  status        QuestionStatus @default(DRAFT)
  source        String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  activities CbtQuestionActivity[] @relation("CbtQuestionActivities")
  category   CbtCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status])
  @@map("cbt_questions")
}

// ---------------------------------------------------------------------------
// CBT 사용자 학습 활동 / 모의고사 기록
// ---------------------------------------------------------------------------

model CbtQuestionActivity {
  userId             String
  questionId         String
  bookmarked         Boolean   @default(false)
  lastIsCorrect      Boolean?
  lastSelectedOption Int?
  attemptCount       Int       @default(0)
  correctCount       Int       @default(0)
  lastAttemptedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question CbtQuestion @relation("CbtQuestionActivities", fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, bookmarked])
  @@index([userId, lastIsCorrect])
  @@map("cbt_question_activities")
}

model CbtExamRecord {
  id              String      @id @default(cuid())
  userId          String
  categoryId      String
  totalQuestions  Int
  correctCount    Int
  score           Int
  passed          Boolean
  durationSeconds Int?
  details         Json
  createdAt       DateTime    @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category CbtCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("cbt_exam_records")
}

// ---------------------------------------------------------------------------
// 광고
// ---------------------------------------------------------------------------

model AdPlacement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adCampaigns AdCampaign[]

  @@map("ad_placements")
}

model AdCampaign {
  id          String           @id @default(cuid())
  companyId   String?
  productId   String?
  placementId String
  regionId    String?
  title       String
  imageUrl    String?
  linkUrl     String?
  startDate   DateTime
  endDate     DateTime
  sortOrder   Int              @default(0)
  status      AdCampaignStatus @default(PENDING)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  placement AdPlacement @relation(fields: [placementId], references: [id])
  region    Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  analyticsEvents AdAnalyticsEvent[]

  @@index([placementId, status, sortOrder])
  @@index([companyId])
  @@index([startDate, endDate])
  @@map("ad_campaigns")
}

model AdAnalyticsEvent {
  id               String               @id @default(cuid())
  campaignId       String
  companyId        String?
  placementId      String
  eventType        AdAnalyticsEventType
  occurredAt       DateTime             @default(now())
  dedupeKey        String?              @unique
  attributionToken String?              @unique
  sourceEventId    String?              @unique
  createdAt        DateTime             @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, eventType, occurredAt])
  @@index([companyId, eventType, occurredAt])
  @@index([placementId, eventType, occurredAt])
  @@index([eventType, occurredAt])
  @@map("ad_analytics_events")
}

// ---------------------------------------------------------------------------
// 결제
// ---------------------------------------------------------------------------

model Product {
  id          String        @id @default(cuid())
  code        String?       @unique
  name        String
  description String?
  type        ProductType   @default(ADVERTISEMENT)
  price       Int
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]
  adCampaigns AdCampaign[]
  recruitmentEntitlement ProductRecruitmentEntitlement?

  @@index([status, type])
  @@map("products")
}

// Gate 4 catalog only. No purchase/payment/credit grant relation is created here.
model CreditPackage {
  id           String             @id @default(cuid())
  code         String             @unique
  displayName  String
  priceKrw     Int
  creditAmount Int
  status       CreditPackageStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@map("credit_packages")
}

// Explicit advertisement Product -> recruitment entitlement definition.
model ProductRecruitmentEntitlement {
  id              String          @id @default(cuid())
  productId       String          @unique
  recruitmentTier RecruitmentTier
  weeklyMatchQuota Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product              Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyEntitlements  CompanyRecruitmentEntitlement[]

  @@map("product_recruitment_entitlements")
}

// Company-owned entitlement instance, separate from catalog definition.
model CompanyRecruitmentEntitlement {
  id                    String                         @id @default(cuid())
  companyId             String
  productEntitlementId  String?
  recruitmentTier       RecruitmentTier
  validFrom             DateTime
  expiresAt             DateTime?
  source                String
  sourceReference       String?
  idempotencyKey        String?                        @unique
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  company              Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productEntitlement   ProductRecruitmentEntitlement? @relation(fields: [productEntitlementId], references: [id], onDelete: SetNull)

  @@index([companyId, validFrom, expiresAt], map: "company_recruitment_entitlements_companyId_validFrom_expiresAt_")
  @@index([companyId, recruitmentTier])
  @@index([companyId, cancelledAt, validFrom, expiresAt], map: "company_recruitment_entitlements_companyId_cancelledAt_validFro")
  @@map("company_recruitment_entitlements")
}

// DB-backed weekly quota aggregate. Counts are distinct from CreditGrant amounts.
model CompanyQuotaUsage {
  id             String             @id @default(cuid())
  companyId      String
  allowanceType  QuotaAllowanceType
  windowStart    DateTime
  windowEnd      DateTime
  consumedCount  Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consumptions  CompanyQuotaConsumption[]

  @@unique([companyId, allowanceType, windowStart])
  @@index([companyId, windowStart, windowEnd])
  @@map("company_quota_usages")
}

// Append-only quota operation audit/idempotency record.
model CompanyQuotaConsumption {
  id               String             @id @default(cuid())
  companyId        String
  quotaUsageId     String
  allowanceType    QuotaAllowanceType
  idempotencyKey   String
  operationReference String?
  consumedCount    Int                @default(1)
  createdAt        DateTime           @default(now())

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotaUsage       CompanyQuotaUsage  @relation(fields: [quotaUsageId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([quotaUsageId, createdAt(sort: Desc)])
  @@index([companyId, allowanceType])
  @@map("company_quota_consumptions")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  amount          Int
  status          OrderStatus @default(PENDING)
  pgProvider      String?
  pgTransactionId String?
  paidAt          DateTime?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Int
  quantity    Int      @default(1)
  amount      Int
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// 관리자 운영 로그
// ---------------------------------------------------------------------------

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_logs")
}

// ---------------------------------------------------------------------------
// CandidateLead 도메인 (Gate 2 — Lead Foundation)
// 독립 Lead: LeasePost SEEK과 분리, User 소유. PII는 User에 재사용.
// ---------------------------------------------------------------------------

model CandidateLead {
  id                String               @id @default(cuid())
  userId            String
  status            CandidateLeadStatus  @default(DRAFT)
  preferredRegionId String?
  vehicleTypeId     String?
  tonnageId         String?
  experienceYears   Int?
  leaseExperience   Boolean?
  vehicleOwned      Boolean?
  licenseInfo       String?
  desiredWorkType   WorkType?
  desiredIncomeMin  Int?
  desiredIncomeMax  Int?
  availableFrom     DateTime?
  careerSummary     String?
  consentVersion    String?
  consentedAt       DateTime?
  expiresAt         DateTime?
  pausedAt          DateTime?
  closedAt          DateTime?
  closeReason       LeadCloseReason?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredRegion Region?      @relation(fields: [preferredRegionId], references: [id], onDelete: SetNull)
  vehicleType     VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  tonnage         Tonnage?     @relation(fields: [tonnageId], references: [id], onDelete: SetNull)
  matches         LeadMatch[]
  unlocks         LeadContactUnlock[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([preferredRegionId])
  @@index([vehicleTypeId])
  @@index([tonnageId])
  @@map("candidate_leads")
}

model LeadMatch {
  id          String         @id @default(cuid())
  companyId   String
  leadId      String
  actorUserId String
  status      LeadMatchStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    CandidateLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User          @relation("LeadMatchActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, leadId])
  @@index([companyId, status])
  @@index([leadId])
  @@index([actorUserId])
  @@map("lead_matches")
}

model LeadContactUnlock {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String
  actorUserId       String
  unlockedAt        DateTime @default(now())
  entitlementSource String
  policyVersion     String
  consentVersion    String
  createdAt         DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    CandidateLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User          @relation("LeadUnlockActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, leadId])
  @@index([companyId])
  @@index([leadId])
  @@index([actorUserId])
  @@map("lead_contact_unlocks")
}

// ---------------------------------------------------------------------------
// CBT Candidate 파이프라인 (STEP 6 영속화)
// NormalizedQuestion → CandidateQuestion. 검증 상태/리뷰/중복 그룹을 보존한다.
// 원칙: No Drop / No Auto Promotion / No Hard Delete / No Auto Merge.
// ---------------------------------------------------------------------------

enum CandidateValidationStatus {
  VALID
  REVIEW_REQUIRED
  REJECTED
}

enum CandidateReviewStatus {
  PENDING
  RESOLVED
  IGNORED
}

model CandidateQuestion {
  id                   String    @id @default(cuid())
  sourceName           String
  sourceQuestionId     String
  /** 원천 페이지 URL. 증거 추적을 위해 보존한다 */
  originalUrl          String?
  /** 원천 페이지 수집 시각 */
  fetchedAt            DateTime?
  /** SnippetStorage에 저장된 snippet id. 없으면 null */
  rawHtmlSnippetId     String?
  category             String
  classificationMethod String
  questionNumber       Int?
  questionText         String
  choices              Json
  normalizedAnswers    Json
  explanation          String?
  explanationReference Json?
  images               Json
  validationStatus     CandidateValidationStatus
  validationErrors     Json
  contentFingerprint   String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  reviews            CandidateReview[]           @relation("CandidateQuestionReviews")
  duplicateMembers   CandidateDuplicateMember[]
  generatedQuestions GeneratedQuestion[]

  @@unique([sourceName, sourceQuestionId])
  @@index([contentFingerprint])
  @@map("candidate_questions")
}

// ---------------------------------------------------------------------------
// CBT Content Production (STEP 8 — AI 콘텐츠 생산 파이프라인)
// CandidateQuestion → Fact Extraction → GeneratedQuestion → Auto-QA → Human Review
// → MasterQuestion. 원칙: No Drop / Append-only / Provenance / Idempotent promotion.
// Candidate는 절대 수정하지 않는다 (파생 레이어만 추가).
// ---------------------------------------------------------------------------

enum GeneratedQuestionStatus {
  GENERATED
  QA_PENDING
  QA_PASSED
  QA_FAILED
  HUMAN_REVIEW
  APPROVED
  REJECTED
  FAILED
}

model GeneratedQuestion {
  id                  String                  @id @default(cuid())
  candidateQuestionId String
  status              GeneratedQuestionStatus @default(GENERATED)
  /** 생성 성공 시에만 채워진다. 실패(FAILED) 행은 null 보존 */
  questionText        String?
  choices             Json?
  answers             Json?
  explanation         String?
  category            String?
  difficulty          String?
  factSourceMapping   Json?
  contentFingerprint  String?
  /** 원문(후보 문제) 대비 유사도. 참고용 위험 플래그일 뿐 법적 판정 아님 */
  similarityScore     Float?
  similarityWarning   Boolean                 @default(false)
  provider            String?
  model               String?
  promptVersion       String?
  rawLlmResponse      Json?
  errorCode           String?
  errorMessage        String?
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  candidateQuestion CandidateQuestion     @relation(fields: [candidateQuestionId], references: [id], onDelete: Cascade)
  qas               GeneratedQuestionQA[]
  masterQuestion    MasterQuestion?

  @@index([candidateQuestionId])
  @@index([status])
  @@index([contentFingerprint])
  @@map("generated_questions")
}

model GeneratedQuestionQA {
  id                  String   @id @default(cuid())
  generatedQuestionId String
  evaluationScores    Json?
  hasHallucination    Boolean?
  isCopyrightSafe     Boolean?
  criticalFlaws       Json?
  qaFeedback          String?
  isPass              Boolean?
  provider            String?
  model               String?
  promptVersion       String?
  rawLlmResponse      Json?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime @default(now())

  generatedQuestion GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id], onDelete: Cascade)

  @@index([generatedQuestionId])
  @@index([isPass])
  @@map("generated_question_qas")
}

model MasterQuestion {
  id                  String   @id @default(cuid())
  generatedQuestionId String   @unique
  category            String
  questionText        String
  choices             Json
  answers             Json
  explanation         String?
  difficulty          String
  isActive            Boolean  @default(true)
  publishedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  generatedQuestion GeneratedQuestion @relation(fields: [generatedQuestionId], references: [id])

  @@index([isActive])
  @@index([category])
  @@map("master_questions")
}

model CandidateReview {
  id                  String                 @id @default(cuid())
  candidateQuestionId String
  validationErrors    Json
  reviewStatus        CandidateReviewStatus  @default(PENDING)
  reviewedBy          String?
  reviewNote          String?
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  candidateQuestion CandidateQuestion @relation("CandidateQuestionReviews", fields: [candidateQuestionId], references: [id], onDelete: Cascade)

  @@unique([candidateQuestionId])
  @@index([reviewStatus])
  @@map("candidate_reviews")
}

model CandidateDuplicateGroup {
  id                String                       @id @default(cuid())
  fingerprint       String                       @unique
  isResolved        Boolean                      @default(false)
  masterCandidateId String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  members CandidateDuplicateMember[]

  @@map("candidate_duplicate_groups")
}

model CandidateDuplicateMember {
  groupId             String
  candidateQuestionId String

  group     CandidateDuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  candidate CandidateQuestion       @relation(fields: [candidateQuestionId], references: [id], onDelete: Cascade)

  @@id([groupId, candidateQuestionId])
  @@index([candidateQuestionId])
  @@map("candidate_duplicate_members")
}

// ---------------------------------------------------------------------------
// Monetization Credit/Ledger Foundation (Gate 3 - STATIC/ISOLATED)
// Economic owner is Company; actorUserId is distinct provenance.
// Ledger is source of truth; no arbitrary balance mutation.
// Append-only CreditTransaction; idempotency prevents duplicate grant/consume.
// Grant/Batch expiry is nullable with no fixed policy.
// Match allowance and ContactUnlock allowance are distinct.
// Money KRW integer and credit integer are conceptually separate (foundation fields/types only).
// No product/price numbers, quota numeric constants, checkout/payment UI.
// ---------------------------------------------------------------------------

enum CreditTransactionType {
  GRANT
  CONSUME
  ADJUSTMENT
  EXPIRE
}

enum CreditAllowanceType {
  MATCH
  CONTACT_UNLOCK
}

model CreditAccount {
  id        String   @id @default(cuid())
  companyId String   @unique
  // Projection of ledger sum; source of truth remains CreditTransaction. No unsafe direct mutation exposed in service API.
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
  grants       CreditGrant[]

  @@index([companyId])
  @@map("credit_accounts")
}

model CreditGrant {
  id              String              @id @default(cuid())
  companyId       String
  creditAccountId String
  // Null means generic paid Company credit; non-null is an operation-specific free/promotion grant.
  allowanceType   CreditAllowanceType?
  source          String
  referenceId     String?
  amount          Int
  remainingAmount Int
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([companyId, allowanceType])
  @@index([creditAccountId])
  @@index([expiresAt])
  @@index([companyId, expiresAt])
  @@map("credit_grants")
}

model CreditTransaction {
  id              String                @id @default(cuid())
  creditAccountId String
  companyId       String
  actorUserId     String?
  type            CreditTransactionType
  allowanceType   CreditAllowanceType?
  amountDelta     Int
  balanceAfter    Int
  source          String?
  referenceType   String?
  referenceId     String?
  idempotencyKey  String
  createdAt       DateTime              @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor         User?         @relation("CreditTransactionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, idempotencyKey])
  @@index([creditAccountId, createdAt(sort: Desc)])
  @@index([companyId, type])
  @@index([actorUserId])
  @@map("credit_transactions")
}
